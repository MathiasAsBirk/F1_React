SERVER_PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/F1-API
CLIENT_ORIGINS=http://localhost:5173

# Use a long random value. Do not expose this through a VITE_ variable.
ADMIN_JWT_SECRET=replace-with-a-long-random-secret

# For local development only. Production should prefer ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD=replace-with-a-strong-password
# ADMIN_PASSWORD_HASH=$2b$12$replace_with_a_bcrypt_hash

# Uncomment only when you deliberately want npm run seed to replace collection data.
# SEED_CONFIRM=replace
